#!/usr/bin/env python3
from http.server import BaseHTTPRequestHandler, HTTPServer
import socket
import sys
import urllib.parse


if len(sys.argv) < 3:
    print(f"Usage: {sys.argv[0]} http_port unix_sock_path", file=sys.stderr)
    sys.exit(1)


http_port = int(sys.argv[1])


client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
client.connect(sys.argv[2])
client_file = client.makefile("wr")

class ForwardHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path.rstrip("/") == "/health":
            self.send_response(200)
        else:
            self.send_response(404)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_POST(self):
        req = self.rfile.read(int(self.headers["Content-Length"])).decode("utf-8")
        print(req.strip(), file=client_file, flush=True)
        resp_data = client_file.readline().encode("utf-8")

        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(resp_data)))
        self.end_headers()
        self.wfile.write(resp_data)


server = HTTPServer(("0.0.0.0", http_port), ForwardHandler)
server.serve_forever()

