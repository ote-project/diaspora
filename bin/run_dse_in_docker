#!/usr/bin/env bash
set -em

# Move MySQL data to tmpfs, then start MySQL.
if [ ! -d "/tmpfs" ]; then
  echo "Directory /tmpfs does not exist."
  exit 1
fi
mv /var/lib/mysql /tmpfs/mysql
ln -s /tmpfs/mysql /var/lib/mysql

mysqld &
while ! mysqladmin ping --silent; do
  sleep 1
  if ! pgrep -x "mysqld" > /dev/null
  then
    cat /var/log/mysql/*.log
    exit 1
  fi
done

# Now start the application.
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR/.."
# The current directory is the `diaspora` directory.
#
if [ -n "${PORT}" ]; then # In web mode
  export DSE_TUNNEL_PATH="/tmp/invocations.sock"
fi

bin/rspec_dse "$@" &
while [ ! -e "$DSE_TUNNEL_PATH" ]; do sleep 0.5; done

if [ -n "${PORT}" ]; then # In web mode
  echo "In web mode"
  bin/web_to_unix_sock_forwarder "${PORT}" "${DSE_TUNNEL_PATH}"
else
  chmod 777 "$DSE_TUNNEL_PATH"
  echo "Set permission on: $DSE_TUNNEL_PATH"
  fg
fi

